{
  "name": "erp",
  "private": true,
  "scripts": {
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build && npm run typecheck:tests",
    "test:selenium": "node --import tsx --test tests/selenium/erp.test.ts",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/selenium-webdriver": "^4.35.7",
    "selenium-webdriver": "^4.51.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
